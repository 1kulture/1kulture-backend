# ============================================
# 1Kulture API - Environment Configuration
# ============================================
# Copy this file to .env and update the values
# ============================================

# App Configuration
APP_NAME=1Kulture
APP_VERSION=1.0.0
ENVIRONMENT=development
API_URL=http://localhost:8080
WEB_URL=http://localhost:3000

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-database-password
DB_NAME=1kulture
DB_SSLMODE=disable
DB_TIMEZONE=UTC

# JWT Configuration
# Generate secure secrets using: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=168h
JWT_ISSUER=1kulture-api
JWT_AUDIENCE=1kulture-web

# Security Configuration
BCRYPT_COST=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_DURATION=15m
PASSWORD_RESET_TIMEOUT=1h
VERIFICATION_TIMEOUT=30m
MAX_VERIFICATION_RETRY=5
ENABLE_2FA=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
TRUSTED_PROXIES=127.0.0.1

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM_NAME=1Kulture
EMAIL_FROM_ADDRESS=noreply@1kulture.com
EMAIL_TEMPLATES_PATH=./templates/email

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_DURATION=1m


#Enable Swagger on Production
ENABLE_SWAGGER=True